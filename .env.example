# Environment configuration placeholder for Rater Agent
ENVIRONMENT=development
PORT=8000

# Google Gemini API (Required for policy fact extraction)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=

# PostgreSQL Database (Supabase / Neon / Local Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rater
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/rater

# S3-compatible Object Storage (Supabase Storage / Cloudflare R2 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=policies
S3_REGION=us-east-1
