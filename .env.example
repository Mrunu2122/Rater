# Production / Staging Environment Configuration
APP_ENV=production

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL Database (Supabase / Render Postgres / AWS RDS)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Object Store (Supabase Storage / AWS S3 / Cloudflare R2)
S3_ENDPOINT_URL=https://your_project.supabase.co/storage/v1/s3
S3_ACCESS_KEY=your_s3_access_key_or_supabase_key
S3_SECRET_KEY=your_s3_secret_key_or_supabase_secret
S3_BUCKET_NAME=policies
S3_REGION=us-east-1

# Server Config
PORT=8000
HOST=0.0.0.0
